        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para acceder a la biblioteca de Lightroom Classic, la app debe estar abierta en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour accéder à la bibliothèque, Lightroom Classic doit être lancé."
