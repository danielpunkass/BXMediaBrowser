    "Status.noAccess.message" : {
      "comment" : "Alert Message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lightroom Bibliothek is nicht lesbar. Bitte erteilen Sie Zugriffsrechte für den Bibliotheksordner. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Lightroom library is not readable. Please grant read access rights for its parent folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La biblioteca de Lightroom no es legible. Concede derechos de acceso de lectura a su carpeta principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bibliothèque Lightroom n'est pas lisible. Veuillez autoriser l'accès pour son dossier parent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La libreria di Lightroom non è leggibile. Si prega di concedere i diritti di accesso in lettura alla sua cartella principale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lightroomライブラリを読み込めません。ライブラリを含むフォルダへの読み出しアクセス権を許可してください。"
          }
        }
      }
    },
