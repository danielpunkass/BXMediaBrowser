    "PreviewSizeAlert.message" : {
      "comment" : "Alert Message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adobe Lightroom Classic stellt die Bilder in einer reduzierten Größe zur Verfügung.\n\nUm das Problem zu beheben, wechseln Sie zu Lightroom Classic und selektieren Sie den Menübefehl  Bibliothek > Vorschauen > 1:1-Vorschauen erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images were provided by Adobe Lightroom Classic at a reduced size.\n\nTo fix the problem, switch to Adobe Lightroom and select the menu item Library > Previews > Build 1:1 Previews."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las imágenes fueron proporcionadas por Adobe Lightroom Classic a un tamaño reducido.\n\nPara solucionar el problema, cambia a Adobe Lightroom y selecciona el ítem de menú Biblioteca > Previsualizaciones > Crear previsualizaciones 1:1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images ont été envoyées par Lightroom Classic à une taille réduite.\n\nPour résoudre le problème, passez à Adobe Lightroom et sélectionnez la commande de menu Bibliothèque > Aperçus > Créer des aperçus 1:1."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le immagini sono state fornite da Adobe Lightroom Classic a dimensione ridotta.\n\nPer risolvere il problema, passa a Adobe Lightroom e seleziona la voce di menu Libreria > Anteprime > Crea anteprime 1:1."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adobe Lightroom Classicから提供された画像は縮小されたサイズです。\n\nこの問題を解決するには、Adobe Lightroomに切り替えて、メニュー項目「ライブラリ」＞「プレビュー」＞「1:1 プレビューを生成」を選択してください。"
          }
        }
      }
    },
