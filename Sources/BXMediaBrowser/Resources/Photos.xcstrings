    "Status.noAccess.message" : {
      "comment" : "Alert Message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte gewähren Sie %1$@ Zugriff auf die Fotos Bibliothek. Gehen Sie zu Systemeinstellungen > Datenschutz & Sicherheit > Fotos. Danach starten Sie %1$@ neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please grant %1$@ access rights to the Photos library in System Settings > Privacy & Security > Photos. Then relaunch %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Concede a %1$@ los derechos de acceso a la biblioteca de Fotos en Ajustes del Sistema > Privacidad y seguridad > Fotos. Luego, reinicia %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez autoriser %1$@ à accéder à la bibliothèque Photos dans Réglages Système > Confidentialité et sécurité > Photos. Relancez ensuite %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si prega di concedere a %1$@ i diritti di accesso alla libreria Foto in Impostazioni di Sistema > Privacy e Sicurezza > Foto. Quindi riavvia %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム設定」＞「プライバシーとセキュリティ」＞「写真」で、%1$@に写真ライブラリへのアクセスを許可してください。その後、%1$@を再度開いてください。"
          }
        }
      }
    },
